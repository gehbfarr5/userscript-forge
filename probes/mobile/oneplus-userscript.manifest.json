{
  "schemaVersion": 1,
  "project": "userscript-environment-check",
  "artifact": {
    "relativePath": "projects/userscript-environment-check/userscripts/userscript-environment-check.user.js",
    "versionSource": "@version",
    "sha256Required": true
  },
  "target": {
    "id": "oneplus-15-firefox-manager",
    "platform": "android",
    "stage": "real",
    "browserPackage": "org.mozilla.firefox",
    "deviceModel": "PLK110",
    "serialPolicy": "explicit-real-serial",
    "hostMapping": "explicit-host-url"
  },
  "paths": {
    "install": "/test-pages/install.html",
    "smoke": "/test-pages/smoke.html"
  },
  "requiredChecks": [
    "firefox-launched",
    "manager-install-surface",
    "script-installed",
    "manager-injection",
    "gm-storage"
  ],
  "evidence": {
    "relativeDirectory": "private/evidence/userscript-environment-check/oneplus-15-firefox-manager",
    "bindsTo": ["sourceCommit", "artifact.sha256"],
    "forbiddenFields": ["serial", "udid", "firefoxProfile", "cookies", "session", "sessionId"]
  }
}
