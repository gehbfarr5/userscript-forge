{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userscript-forge.local/schemas/result.schema.json",
  "schemaVersion": 1,
  "title": "Userscript Forge run result",
  "type": "object",
  "required": ["schemaVersion", "runId", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "SKIP", "BLOCKED", "NOT_RUN"] },
    "project": { "type": "string", "minLength": 1 },
    "probe": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "artifact": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "environment": { "type": "object", "additionalProperties": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "SKIP", "BLOCKED", "NOT_RUN"] }
        },
        "additionalProperties": true
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "observations": { "type": "array", "items": { "type": "object" } },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
