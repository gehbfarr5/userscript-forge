{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userscript-forge.local/schemas/project.schema.json",
  "schemaVersion": 1,
  "title": "Userscript Forge project",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "mode", "targets", "permissions", "release"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["direct", "bundle"] },
    "build": {
      "type": "object",
      "required": ["adapter", "entry", "output", "minify"],
      "properties": {
        "adapter": { "const": "esbuild" },
        "entry": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "pattern": "^dist/.+\\.user\\.js$" },
        "minify": { "const": false }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "required": ["matches", "requiredVerification"],
      "properties": {
        "matches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredVerification": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "required": ["grants", "connect", "justifications"],
      "properties": {
        "grants": { "type": "array", "items": { "type": "string" } },
        "connect": { "type": "array", "items": { "type": "string" } },
        "justifications": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["githubRepository", "greasyForkRequired"],
      "properties": {
        "githubRepository": { "type": "string", "minLength": 1 },
        "greasyForkRequired": { "type": "boolean" },
        "releaseBranch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
