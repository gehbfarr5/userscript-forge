{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userscript-forge.local/schemas/project.schema.json",
  "schemaVersion": 1,
  "title": "Userscript Forge project",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "mode", "targets", "permissions", "release"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["direct", "bundle"] },
    "build": {
      "type": "object",
      "required": ["adapter", "entry", "output", "minify"],
      "properties": {
        "adapter": { "const": "esbuild" },
        "entry": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "pattern": "^dist/.+\\.user\\.js$" },
        "minify": { "const": false }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "required": ["matches", "requiredVerification"],
      "properties": {
        "matches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredVerification": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "mobileVerification": {
          "type": "object",
          "required": ["installPath", "smoke", "requiredChecks"],
          "properties": {
            "installPath": { "type": "string", "pattern": "^/" },
            "smoke": {
              "type": "object",
              "required": ["url", "requiredText"],
              "properties": {
                "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
                "requiredText": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            },
            "requiredChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "acceptanceChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
            "automationAssertions": {
              "type": "object",
              "required": ["domMarker"],
              "properties": {
                "domMarker": {
                  "type": "object",
                  "required": ["selector", "attribute", "equals"],
                  "properties": {
                    "selector": { "type": "string", "minLength": 1 },
                    "attribute": { "type": "string", "pattern": "^[a-zA-Z_:][-a-zA-Z0-9_:.]*$" },
                    "equals": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "layout": {
                  "type": "object",
                  "required": ["selector", "width", "horizontallyScrollable"],
                  "properties": {
                    "selector": { "type": "string", "minLength": 1 },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "horizontallyScrollable": { "const": true }
                  },
                  "additionalProperties": false
                },
                "toggle": {
                  "type": "object",
                  "required": ["selector", "stateAttribute", "enabledValue", "disabledValue"],
                  "properties": {
                    "selector": { "type": "string", "minLength": 1 },
                    "stateAttribute": { "type": "string", "pattern": "^[a-zA-Z_:][-a-zA-Z0-9_:.]*$" },
                    "enabledValue": { "type": "string" },
                    "disabledValue": { "type": "string" },
                    "enabledRootClass": { "type": "string", "pattern": "^[a-zA-Z_][-a-zA-Z0-9_]*$" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "required": ["grants", "connect", "justifications"],
      "properties": {
        "grants": { "type": "array", "items": { "type": "string" } },
        "connect": { "type": "array", "items": { "type": "string" } },
        "justifications": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["githubRepository", "greasyForkRequired"],
      "properties": {
        "githubRepository": { "type": "string", "minLength": 1 },
        "greasyForkRequired": { "type": "boolean" },
        "greasyForkAdultContent": { "type": "boolean" },
        "releaseBranch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
