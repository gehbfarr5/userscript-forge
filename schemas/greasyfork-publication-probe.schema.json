{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userscript-forge.local/schemas/greasyfork-publication-probe.schema.json",
  "schemaVersion": 1,
  "title": "Userscript Forge Greasy Fork browser publication manifest",
  "type": "object",
  "required": ["schemaVersion", "platform", "mode", "paths", "requiredChecks", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platform": { "const": "greasyfork" },
    "mode": { "const": "browser-orchestrated" },
    "paths": {
      "type": "object",
      "required": ["create", "update", "scriptPage", "codePage"],
      "properties": {
        "create": { "type": "string", "pattern": "^/" },
        "update": { "type": "string", "pattern": "^/.*\\{scriptId\\}.*$" },
        "scriptPage": { "type": "string", "pattern": "^/.*\\{scriptId\\}.*$" },
        "codePage": { "type": "string", "pattern": "^/.*\\{scriptId\\}.*$" }
      },
      "additionalProperties": false
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "object",
      "required": ["relativeDirectory", "bindsTo", "forbiddenFields"],
      "properties": {
        "relativeDirectory": { "type": "string", "pattern": "^private/evidence/" },
        "bindsTo": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["sourceCommit", "artifact.sha256"] }
        },
        "forbiddenFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
